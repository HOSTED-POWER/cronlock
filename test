#!/usr/bin/env bash
set -euo pipefail

bash -n cronlock

# Keep the installed command dependency-free of Python. The Python test harness
# can run beside a disposable Redis server when redis-cli is not on this host.
if ! command -v redis-cli >/dev/null 2>&1; then
  command -v docker >/dev/null 2>&1 || {
    echo 'Install redis-cli or Docker to run the tests.' >&2
    exit 1
  }
  docker run --rm -v "$PWD:/src:ro" -w /src redis:7-alpine sh -ec '
    apk add --no-cache bash python3 coreutils util-linux iproute2 >/dev/null
    redis-server --daemonize yes
    CRONLOCK_TEST_HOST=127.0.0.1 CRONLOCK_TEST_PORT=6379 python3 -m unittest discover -s tests -v
  '
  exit
fi

cronlock_test_container=""
if [[ -z "${CRONLOCK_TEST_PORT:-}" ]]; then
  if ! command -v docker >/dev/null 2>&1; then
    echo "Set CRONLOCK_TEST_PORT to a disposable Redis port, or install Docker." >&2
    exit 1
  fi
  cronlock_test_container="$(docker run --rm -d -p 127.0.0.1::6379 redis:7-alpine)"
  trap 'docker stop "$cronlock_test_container" >/dev/null' EXIT
  export CRONLOCK_TEST_PORT
  CRONLOCK_TEST_PORT="$(docker port "$cronlock_test_container" 6379/tcp | awk -F: '{print $NF}')"
  for _ in {1..50}; do
    if docker exec "$cronlock_test_container" redis-cli ping >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
fi

python3 -m unittest discover -s tests -v
