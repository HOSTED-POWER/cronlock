#!/usr/bin/env python3
"""Run one copy of a command under a renewable Redis lease.

The command-line and CRONLOCK_* settings intentionally match the historical
shell tool. Redis is accessed through RESP directly, so no Python package or
redis-cli installation is required.
"""

from __future__ import annotations

import hashlib
import ipaddress
import os
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path


SKIPPED = 200
ERROR = 201
TIMED_OUT = 202

RENEW_SCRIPT = (
    "if redis.call('GET', KEYS[1]) == ARGV[1] then "
    "return redis.call('PEXPIRE', KEYS[1], ARGV[2]) else return 0 end"
)
FINISH_SCRIPT = (
    "if redis.call('GET', KEYS[1]) ~= ARGV[1] then return 0 end "
    "if tonumber(ARGV[2]) > 0 then "
    "return redis.call('PEXPIRE', KEYS[1], ARGV[2]) "
    "else return redis.call('DEL', KEYS[1]) end"
)
LEGACY_SCRIPT = (
    "local value = redis.call('GET', KEYS[1]); "
    "if not value or #value > 12 or not string.match(value, '^%d+$') then return 0 end; "
    "local deadline = tonumber(value); "
    "if not deadline then return 0 end; "
    "local now = tonumber(redis.call('TIME')[1]); "
    "if deadline <= now then "
    "redis.call('SET', KEYS[1], ARGV[1], 'PX', ARGV[2]); return 1 end; "
    "if redis.call('PTTL', KEYS[1]) < 0 then "
    "redis.call('PEXPIRE', KEYS[1], math.max(1, math.ceil((deadline - now) * 1000))) end; "
    "return 0"
)


class CronlockError(Exception):
    """A failed precondition or a Redis operation that must stop the job."""


class RedisReplyError(CronlockError):
    """An error reply from Redis, including cluster redirection replies."""


def load_settings() -> dict[str, str]:
    """Source the existing Bash-style config without changing its precedence.

    The old tool sourced its config after reading the environment. Bash is used
    only for that compatibility step; Redis replies are never interpreted by a
    shell. Config files are trusted executable files, as they were before.
    """
    settings = dict(os.environ)
    requested = settings.get("CRONLOCK_CONFIG", "")
    candidates = (
        [Path(requested)]
        if requested
        else [
            Path(__file__).resolve().parent / "cronlock.conf",
            Path("/etc/cronlock.conf"),
        ]
    )
    config = next((path for path in candidates if path.exists()), None)
    if requested and config is None:
        raise CronlockError(f"config file does not exist: {requested}")
    if config is None:
        return settings

    # set -a exports assignments that an ordinary Bash `source` would keep
    # local. env -0 preserves spaces/newlines inside values without eval.
    try:
        result = subprocess.run(
            [
                "bash",
                "-c",
                'set -a; source "$1" || exit; env -0',
                "cronlock",
                str(config),
            ],
            env=settings,
            capture_output=True,
            check=False,
        )
    except OSError as exc:
        raise CronlockError(f"cannot load config file {config}: {exc}") from exc
    if result.returncode:
        raise CronlockError(f"cannot load config file: {config}")
    for item in result.stdout.split(b"\0"):
        name, separator, value = item.partition(b"=")
        if separator and name.startswith(b"CRONLOCK_"):
            settings[name.decode()] = value.decode(errors="surrogateescape")
    return settings


def number(
    settings: dict[str, str], name: str, default: float, *, minimum: float = 0
) -> float:
    try:
        value = float(settings.get(name, str(default)))
    except ValueError as exc:
        raise CronlockError(f"{name} must be a number") from exc
    if not minimum <= value < float("inf"):
        raise CronlockError(f"{name} must be at least {minimum}")
    return value


def integer(
    settings: dict[str, str],
    name: str,
    default: int,
    *,
    minimum: int = 0,
    maximum: int | None = None,
) -> int:
    try:
        value = int(settings.get(name, str(default)))
    except ValueError as exc:
        raise CronlockError(f"{name} must be an integer") from exc
    if value < minimum or (maximum is not None and value > maximum):
        raise CronlockError(f"{name} is outside its allowed range")
    return value


def verbose(settings: dict[str, str], message: str) -> None:
    if settings.get("CRONLOCK_VERBOSE", "no") == "yes":
        print(message, file=sys.stderr, flush=True)


def local_vip_owner(settings: dict[str, str]) -> bool:
    address = settings.get("CRONLOCK_LOCAL_VIP", "")
    if not address:
        return True
    try:
        vip = ipaddress.ip_address(address)
    except ValueError as exc:
        raise CronlockError("CRONLOCK_LOCAL_VIP must be one IP address") from exc
    family = "-4" if vip.version == 4 else "-6"
    prefix = 32 if vip.version == 4 else 128
    # Cron commonly omits /usr/sbin from PATH for unprivileged users.
    ip_command = shutil.which("ip") or next(
        (path for path in ("/usr/sbin/ip", "/sbin/ip") if Path(path).is_file()),
        None,
    )
    if ip_command is None:
        raise CronlockError("iproute2 is required for CRONLOCK_LOCAL_VIP")
    try:
        result = subprocess.run(
            [ip_command, "-o", family, "addr", "show", "to", f"{vip}/{prefix}"],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise CronlockError("cannot inspect local IP addresses") from exc
    if result.returncode:
        raise CronlockError("local IP address check failed")
    for line in result.stdout.splitlines():
        fields = line.split()
        for position, field in enumerate(fields[:-1]):
            if field in {"inet", "inet6"}:
                try:
                    if ipaddress.ip_interface(fields[position + 1]).ip == vip:
                        return True
                except ValueError:
                    pass
    return False


def _wire(*arguments: object) -> bytes:
    parts = [f"*{len(arguments)}\r\n".encode()]
    for argument in arguments:
        value = str(argument).encode()
        parts.extend((f"${len(value)}\r\n".encode(), value, b"\r\n"))
    return b"".join(parts)


def _read_reply(stream):
    kind = stream.read(1)
    line = stream.readline(1024 * 1024)
    if not kind or not line.endswith(b"\r\n"):
        raise CronlockError("Redis closed the connection mid-reply")
    body = line[:-2]
    if kind == b"+":
        return body.decode()
    if kind == b"-":
        raise RedisReplyError(body.decode(errors="replace"))
    if kind == b":":
        return int(body)
    if kind == b"$":
        length = int(body)
        if length == -1:
            return None
        if length < 0 or length > 16 * 1024 * 1024:
            raise CronlockError("invalid Redis bulk reply length")
        value = stream.read(length + 2)
        if len(value) != length + 2 or not value.endswith(b"\r\n"):
            raise CronlockError("Redis sent a truncated bulk reply")
        return value[:-2].decode()
    if kind == b"*":
        length = int(body)
        if length == -1:
            return None
        if length < 0 or length > 1024:
            raise CronlockError("invalid Redis array reply length")
        return [_read_reply(stream) for _ in range(length)]
    raise CronlockError("unsupported Redis reply type")


def _transact(sock: socket.socket, stream, *arguments: object):
    sock.sendall(_wire(*arguments))
    return _read_reply(stream)


class RedisClient:
    """One-command Redis client with authentication and optional redirects."""

    def __init__(
        self,
        settings: dict[str, str],
        *,
        timeout: float | None = None,
        attempts: int | None = None,
    ):
        self.settings = settings
        self.timeout = timeout or number(
            settings, "CRONLOCK_REDIS_TIMEOUT", 5, minimum=0.1
        )
        self.host = settings.get("CRONLOCK_HOST", "localhost")
        self.port = integer(settings, "CRONLOCK_PORT", 6379, minimum=1, maximum=65535)
        self.database = integer(settings, "CRONLOCK_DB", 0)
        self.attempts = (
            integer(settings, "CRONLOCK_RECONNECT_ATTEMPTS", 5, maximum=100)
            if attempts is None
            else attempts
        )
        self.backoff = number(settings, "CRONLOCK_RECONNECT_BACKOFF", 1)

    def _master_address(self) -> tuple[str, int]:
        if self.settings.get("CRONLOCK_USE_SENTINEL", "no") != "yes":
            return self.host, self.port
        host = self.settings.get("CRONLOCK_SENTINEL_HOST", "localhost")
        port = integer(
            self.settings, "CRONLOCK_SENTINEL_PORT", 26379, minimum=1, maximum=65535
        )
        master = self.settings.get("CRONLOCK_SENTINEL_MASTER", "mymaster")
        with socket.create_connection((host, port), self.timeout) as sock:
            sock.settimeout(self.timeout)
            with sock.makefile("rb") as stream:
                auth = self.settings.get("CRONLOCK_SENTINEL_AUTH", "")
                if auth:
                    _transact(sock, stream, "AUTH", auth)
                result = _transact(
                    sock, stream, "SENTINEL", "get-master-addr-by-name", master
                )
        if not isinstance(result, list) or len(result) != 2:
            raise CronlockError(f"Sentinel has no master named {master}")
        return str(result[0]), int(result[1])

    def _once(
        self,
        host: str,
        port: int,
        arguments: tuple[object, ...],
        *,
        asking: bool = False,
    ):
        with socket.create_connection((host, port), self.timeout) as sock:
            sock.settimeout(self.timeout)
            with sock.makefile("rb") as stream:
                auth = self.settings.get("CRONLOCK_AUTH", "")
                if auth:
                    user = self.settings.get("CRONLOCK_USER", "")
                    if user:
                        _transact(sock, stream, "AUTH", user, auth)
                    else:
                        _transact(sock, stream, "AUTH", auth)
                if self.database:
                    _transact(sock, stream, "SELECT", self.database)
                if asking:
                    _transact(sock, stream, "ASKING")
                return _transact(sock, stream, *arguments)

    def execute(self, *arguments: object):
        last_error = None
        for attempt in range(self.attempts + 1):
            try:
                host, port = self._master_address()
                for _ in range(6):
                    try:
                        return self._once(host, port, arguments)
                    except RedisReplyError as exc:
                        parts = str(exc).split()
                        if len(parts) != 3 or parts[0] not in {"MOVED", "ASK"}:
                            raise
                        host, separator, target_port = parts[2].rpartition(":")
                        if not separator:
                            raise
                        host = host.strip("[]")
                        port = int(target_port)
                        if parts[0] == "ASK":
                            return self._once(host, port, arguments, asking=True)
                raise CronlockError("too many Redis Cluster redirects")
            except (OSError, TimeoutError, CronlockError) as exc:
                last_error = exc
                if isinstance(exc, RedisReplyError) or attempt == self.attempts:
                    break
                time.sleep(min(self.backoff * attempt, 5))
        raise CronlockError(f"Redis command failed: {last_error}") from last_error


class LeaseMonitor(threading.Thread):
    """Renew the lease; VIP ownership gates startup, not active jobs."""

    def __init__(self, settings: dict[str, str], key: str, token: str, lease: float):
        super().__init__(daemon=True)
        self.settings = settings
        self.key = key
        self.token = token
        self.lease = lease
        self.stop_requested = threading.Event()
        self.lost_reason = ""

    def run(self):
        interval = min(1.0, max(0.2, self.lease / 3))
        next_renewal = time.monotonic() + self.lease / 3
        last_renewal = time.monotonic()
        while not self.stop_requested.wait(interval):
            try:
                now = time.monotonic()
                if now < next_renewal:
                    continue
                timeout = min(
                    number(self.settings, "CRONLOCK_REDIS_TIMEOUT", 5, minimum=0.1),
                    self.lease / 4,
                )
                # A renewal must have a bounded single attempt. Retrying inside
                # the client can outlive the lease and delay fail-closed shutdown.
                result = RedisClient(
                    self.settings, timeout=timeout, attempts=0
                ).execute(
                    "EVAL",
                    RENEW_SCRIPT,
                    1,
                    self.key,
                    self.token,
                    int(self.lease * 1000),
                )
                if result != 1:
                    self.lost_reason = "Redis lease is no longer owned by this command"
                    return
                last_renewal = time.monotonic()
                next_renewal = last_renewal + self.lease / 3
            # An unexpected exception in this thread must not leave work running
            # with an expired lease.
            except Exception as exc:
                verbose(self.settings, f"lease renewal delayed: {exc}")
                if time.monotonic() >= last_renewal + self.lease * 0.5:
                    self.lost_reason = "Redis lease could not be renewed safely"
                    return
                next_renewal = time.monotonic() + interval


def stop_process_group(process: subprocess.Popen, grace: float) -> None:
    # The direct child can exit before a detached grandchild does. Kill the
    # whole process group, including those descendants, on a safety stop.
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + grace
    while time.monotonic() < deadline:
        process.poll()  # Reap the direct child so a lone zombie cannot hold the group ID.
        try:
            os.killpg(process.pid, 0)
        except ProcessLookupError:
            break
        time.sleep(0.05)
    else:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    if process.poll() is None:
        process.wait()


def run_command(settings: dict[str, str], arguments: list[str]) -> int:
    if not arguments:
        raise CronlockError("usage: cronlock command [argument ...]")
    if settings.get("CRONLOCK_RESET", "no") == "yes":
        raise CronlockError(
            "CRONLOCK_RESET is unsafe for live leases and is no longer supported"
        )
    if not local_vip_owner(settings):
        verbose(settings, "local VIP is absent; skipping command")
        return SKIPPED

    key_name = (
        settings.get("CRONLOCK_KEY")
        or hashlib.md5(  # noqa: S324 - legacy key format
            (" ".join(arguments) + "\n").encode()
        ).hexdigest()
    )
    key = settings.get("CRONLOCK_PREFIX", "cronlock.") + key_name
    lease = number(settings, "CRONLOCK_LEASE", 90, minimum=1)
    shutdown_grace = min(5, lease / 4)
    grace = number(settings, "CRONLOCK_GRACE", 40)
    maximum_run = number(settings, "CRONLOCK_TIMEOUT", 0)
    token = secrets.token_hex(24)
    acquired = RedisClient(settings).execute(
        "SET", key, token, "NX", "PX", int(lease * 1000)
    )
    if acquired is None:
        # An old cronlock could leave a numeric timestamp without a Redis TTL.
        # Preserve its original deadline, but prevent it from blocking forever.
        migrated = RedisClient(settings).execute(
            "EVAL", LEGACY_SCRIPT, 1, key, token, int(lease * 1000)
        )
        if migrated != 1:
            verbose(settings, f"{key} is already held; skipping command")
            return SKIPPED
        acquired = "OK"
    if acquired != "OK":
        raise CronlockError("Redis returned an unexpected lease acquisition result")

    started = time.monotonic()
    monitor = LeaseMonitor(settings, key, token, lease)
    process = None
    exit_code = ERROR
    stop_signal = threading.Event()
    old_handlers = {}

    def request_stop(_signum, _frame):
        stop_signal.set()

    try:
        for signum in (signal.SIGTERM, signal.SIGINT):
            old_handlers[signum] = signal.signal(signum, request_stop)
        if not local_vip_owner(settings):
            raise CronlockError("local VIP disappeared before command startup")
        try:
            process = subprocess.Popen(arguments, start_new_session=True)
        except OSError as exc:
            raise CronlockError(f"cannot start command: {exc}") from exc
        monitor.start()
        while process.poll() is None:
            if monitor.lost_reason:
                print(f"cronlock: {monitor.lost_reason}", file=sys.stderr)
                stop_process_group(process, shutdown_grace)
                exit_code = ERROR
                break
            if not monitor.is_alive() and not monitor.stop_requested.is_set():
                print("cronlock: lease monitor stopped unexpectedly", file=sys.stderr)
                stop_process_group(process, shutdown_grace)
                exit_code = ERROR
                break
            if stop_signal.is_set():
                stop_process_group(process, shutdown_grace)
                exit_code = 128 + signal.SIGTERM
                break
            if maximum_run and time.monotonic() - started >= maximum_run:
                print("cronlock: command timed out", file=sys.stderr)
                stop_process_group(process, shutdown_grace)
                exit_code = TIMED_OUT
                break
            time.sleep(0.1)
        else:
            result = process.returncode
            exit_code = 128 - result if result < 0 else result
            if monitor.lost_reason:
                exit_code = ERROR
    finally:
        if process is not None and process.poll() is None:
            stop_process_group(process, shutdown_grace)
        monitor.stop_requested.set()
        if monitor.is_alive():
            monitor.join()
        for signum, handler in old_handlers.items():
            signal.signal(signum, handler)
        remaining_grace = max(0, round((started + grace - time.monotonic()) * 1000))
        try:
            RedisClient(settings).execute(
                "EVAL", FINISH_SCRIPT, 1, key, token, remaining_grace
            )
        except CronlockError as exc:
            print(f"cronlock: could not release lease: {exc}", file=sys.stderr)
            exit_code = ERROR
    return exit_code


def main() -> int:
    try:
        settings = load_settings()
        return run_command(settings, sys.argv[1:])
    except (CronlockError, ValueError) as exc:
        print(f"cronlock: {exc}", file=sys.stderr)
        return ERROR


if __name__ == "__main__":
    sys.exit(main())
