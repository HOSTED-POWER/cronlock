#!/usr/bin/env bash
# Run one copy of a command with a short, renewable Redis lease.
# The historical cronlock command line, config file, and lock key are preserved.

export LC_ALL=C

die() {
  printf 'cronlock: %s\n' "$*" >&2
  exit 201
}

info() {
  if [[ ${CRONLOCK_VERBOSE:-no} == yes ]]; then
    printf 'cronlock: %s\n' "$*" >&2
  fi
}

seconds_to_ms() {
  [[ $1 =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
  awk -v value="$1" -v minimum="$2" 'BEGIN {
    if (value < minimum) exit 1
    printf "%.0f", value * 1000
  }'
}

ms_to_seconds() {
  printf '%d.%03d' "$(( $1 / 1000 ))" "$(( $1 % 1000 ))"
}

script_dir=${BASH_SOURCE[0]%/*}
[[ $script_dir == "${BASH_SOURCE[0]}" ]] && script_dir=.
if [[ -n ${CRONLOCK_CONFIG:-} ]]; then
  [[ -f $CRONLOCK_CONFIG ]] || die "config file does not exist: $CRONLOCK_CONFIG"
elif [[ -f $script_dir/cronlock.conf ]]; then
  CRONLOCK_CONFIG=$script_dir/cronlock.conf
elif [[ -f /etc/cronlock.conf ]]; then
  CRONLOCK_CONFIG=/etc/cronlock.conf
fi
if [[ -n ${CRONLOCK_CONFIG:-} ]]; then
  # The config has always been trusted executable Bash, loaded after the env.
  # shellcheck source=/dev/null
  source "$CRONLOCK_CONFIG" || die "cannot load config file: $CRONLOCK_CONFIG"
fi

: "${CRONLOCK_HOST:=localhost}"
: "${CRONLOCK_PORT:=6379}"
: "${CRONLOCK_DB:=0}"
: "${CRONLOCK_GRACE:=40}"
: "${CRONLOCK_LEASE:=90}"
: "${CRONLOCK_TIMEOUT:=0}"
: "${CRONLOCK_REDIS_TIMEOUT:=5}"
: "${CRONLOCK_RECONNECT_ATTEMPTS:=5}"
: "${CRONLOCK_RECONNECT_BACKOFF:=1}"
: "${CRONLOCK_PREFIX:=cronlock.}"
: "${CRONLOCK_USE_SENTINEL:=no}"
: "${CRONLOCK_SENTINEL_HOST:=localhost}"
: "${CRONLOCK_SENTINEL_PORT:=26379}"
: "${CRONLOCK_SENTINEL_MASTER:=mymaster}"

[[ $# -gt 0 ]] || die 'usage: cronlock command [argument ...]'
[[ ${CRONLOCK_RESET:-no} != yes ]] || die 'CRONLOCK_RESET is unsafe for live leases and is no longer supported'

local_vip_owner() {
  local address=${CRONLOCK_LOCAL_VIP:-} family=-4 prefix=32 ip_command output
  [[ -n $address ]] || return 0
  if [[ $address == *:* ]]; then
    family=-6
    prefix=128
  fi
  ip_command=$(command -v ip 2>/dev/null) || ip_command=''
  [[ -n $ip_command ]] || {
    [[ -x /usr/sbin/ip ]] && ip_command=/usr/sbin/ip
    [[ -x /sbin/ip && -z $ip_command ]] && ip_command=/sbin/ip
  }
  [[ -n $ip_command ]] || die 'iproute2 is required for CRONLOCK_LOCAL_VIP'
  output=$("$ip_command" -o "$family" addr show to "$address/$prefix" 2>/dev/null) || die 'local IP address check failed'
  [[ -n $output ]]
}

# A non-owner does not need Redis at all. Recheck after acquisition so a VIP
# handoff between those two points cannot start a new job on the old owner.
if ! local_vip_owner; then
  info 'local VIP is absent; skipping command'
  exit 200
fi

redis_cli=$(command -v redis-cli 2>/dev/null) || die 'redis-cli is required'
command -v timeout >/dev/null 2>&1 || die 'GNU timeout is required'
command -v setsid >/dev/null 2>&1 || die 'setsid is required'
command -v md5sum >/dev/null 2>&1 || die 'md5sum is required'
command -v od >/dev/null 2>&1 || die 'od is required'
command -v "$1" >/dev/null 2>&1 || die "cannot start command: $1"

lease_ms=$(seconds_to_ms "$CRONLOCK_LEASE" 1) || die 'CRONLOCK_LEASE must be at least one second'
grace_ms=$(seconds_to_ms "$CRONLOCK_GRACE" 0) || die 'CRONLOCK_GRACE must be nonnegative'
run_limit_ms=$(seconds_to_ms "$CRONLOCK_TIMEOUT" 0) || die 'CRONLOCK_TIMEOUT must be nonnegative'
seconds_to_ms "$CRONLOCK_REDIS_TIMEOUT" 0.1 >/dev/null || die 'CRONLOCK_REDIS_TIMEOUT must be positive'
backoff_ms=$(seconds_to_ms "$CRONLOCK_RECONNECT_BACKOFF" 0) || die 'CRONLOCK_RECONNECT_BACKOFF must be nonnegative'
[[ $CRONLOCK_RECONNECT_ATTEMPTS =~ ^[0-9]+$ ]] || die 'CRONLOCK_RECONNECT_ATTEMPTS must be an integer'
[[ $CRONLOCK_DB =~ ^[0-9]+$ && $CRONLOCK_PORT =~ ^[0-9]+$ ]] || die 'Redis port and database must be integers'
[[ -z ${CRONLOCK_USER:-} || -n ${CRONLOCK_AUTH:-} ]] || die 'CRONLOCK_USER requires CRONLOCK_AUTH'

redis_once() {
  local max_time=$1 host=$CRONLOCK_HOST port=$CRONLOCK_PORT sentinel_reply reply line
  shift
  if [[ $CRONLOCK_USE_SENTINEL == yes ]]; then
    if [[ -n ${CRONLOCK_SENTINEL_AUTH:-} ]]; then
      export REDISCLI_AUTH=$CRONLOCK_SENTINEL_AUTH
    else
      unset REDISCLI_AUTH
    fi
    sentinel_reply=$(timeout "$max_time" \
      "$redis_cli" --raw -h "$CRONLOCK_SENTINEL_HOST" -p "$CRONLOCK_SENTINEL_PORT" \
      SENTINEL get-master-addr-by-name "$CRONLOCK_SENTINEL_MASTER" 2>&1) || return 1
    [[ $sentinel_reply != *'AUTH failed'* ]] || return 1
    local -a address
    mapfile -t address <<< "$sentinel_reply"
    [[ ${#address[@]} -eq 2 && ${address[1]} =~ ^[0-9]+$ ]] || return 1
    host=${address[0]}
    port=${address[1]}
  fi
  local -a options=(--raw -c -h "$host" -p "$port" -n "$CRONLOCK_DB")
  [[ -n ${CRONLOCK_USER:-} ]] && options+=(--user "$CRONLOCK_USER")
  if [[ -n ${CRONLOCK_AUTH:-} ]]; then
    export REDISCLI_AUTH=$CRONLOCK_AUTH
  else
    unset REDISCLI_AUTH
  fi
  reply=$(timeout "$max_time" "$redis_cli" "${options[@]}" "$@" 2>&1) || return 1
  # redis-cli may execute a command as the unauthenticated default user even
  # after a configured AUTH fails. Never treat that command's reply as success.
  [[ $reply != *'AUTH failed'* && $reply != *WRONGPASS* && $reply != *NOAUTH* && $reply != *' failed: '* ]] || return 1
  while IFS= read -r line; do
    [[ $line == '-> Redirected to slot '* ]] && continue
    printf '%s\n' "$line"
  done <<< "$reply"
}

redis_call() {
  local attempt reply delay_ms
  for ((attempt = 0; attempt <= CRONLOCK_RECONNECT_ATTEMPTS; attempt++)); do
    if reply=$(redis_once "$CRONLOCK_REDIS_TIMEOUT" "$@"); then
      printf '%s' "$reply"
      return 0
    fi
    (( attempt < CRONLOCK_RECONNECT_ATTEMPTS )) || break
    delay_ms=$(( backoff_ms * attempt ))
    sleep "$(ms_to_seconds "$delay_ms")"
  done
  return 1
}

# redis-cli can continue with the command in database zero after SELECT fails.
# Check a non-default database before issuing any mutating lease command.
if [[ $CRONLOCK_DB != 0 ]]; then
  [[ $(redis_call PING) == PONG ]] || die 'cannot select Redis database'
fi

# The random token prevents an expired owner from renewing or releasing its
# successor's lease. Lua keeps each token check and write atomic.
renew_lua="if redis.call('GET', KEYS[1]) == ARGV[1] then return redis.call('PEXPIRE', KEYS[1], ARGV[2]) else return 0 end"
finish_lua="if redis.call('GET', KEYS[1]) ~= ARGV[1] then return 0 end
  if tonumber(ARGV[2]) > 0 then return redis.call('PEXPIRE', KEYS[1], ARGV[2]) end
  return redis.call('DEL', KEYS[1])"
legacy_lua="local value = redis.call('GET', KEYS[1])
  if not value or #value > 12 or not string.match(value, '^%d+$') then return 0 end
  local deadline = tonumber(value)
  if not deadline then return 0 end
  local now = tonumber(redis.call('TIME')[1])
  if deadline <= now then
    redis.call('SET', KEYS[1], ARGV[1], 'PX', ARGV[2]); return 1
  end
  if redis.call('PTTL', KEYS[1]) < 0 then
    redis.call('PEXPIRE', KEYS[1], math.max(1, math.ceil((deadline - now) * 1000)))
  end
  return 0"

key_name=${CRONLOCK_KEY:-}
if [[ -z $key_name ]]; then
  key_name=$(printf '%s\n' "$*" | md5sum)
  key_name=${key_name%% *}
fi
key=${CRONLOCK_PREFIX}${key_name}
token=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
[[ ${#token} -eq 48 ]] || die 'could not generate a Redis lease token'

owner_pid=$$
child_pid=0
monitor_pid=0
timer_pid=0
stop_reason=''

stop_job() {
  [[ -n $stop_reason ]] || stop_reason=$1
  if (( child_pid > 0 )); then
    # setsid may not have created the new process group yet at startup.
    kill -TERM -- "-$child_pid" 2>/dev/null || kill -TERM "$child_pid" 2>/dev/null || true
  fi
}

trap 'stop_job term' TERM
trap 'stop_job int' INT
trap 'stop_job lease' USR1
trap 'stop_job timeout' USR2

acquired=$(redis_call SET "$key" "$token" NX PX "$lease_ms") || die 'cannot acquire Redis lease'
if [[ -z $acquired ]]; then
  acquired=$(redis_call EVAL "$legacy_lua" 1 "$key" "$token" "$lease_ms") || die 'cannot inspect an existing Redis lock'
  [[ $acquired == 1 || $acquired == 0 ]] || die 'Redis rejected legacy lock migration'
  if [[ $acquired == 0 ]]; then
    info "$key is already held; skipping command"
    exit 200
  fi
elif [[ $acquired != OK ]]; then
  die "Redis rejected lease acquisition: $acquired"
fi

release_lease() {
  local remaining_ms=$1 result
  result=$(redis_call EVAL "$finish_lua" 1 "$key" "$token" "$remaining_ms") || return 1
  [[ $result == 1 ]]
}

if [[ -n $stop_reason ]]; then
  release_lease 0 || die 'Redis lease could not be released after interruption'
  [[ $stop_reason == int ]] && exit 130
  exit 143
fi

if ! local_vip_owner; then
  release_lease 0 || die 'local VIP moved and Redis lease could not be released'
  die 'local VIP disappeared before command startup'
fi

started_ms=$(date +%s%3N)
monitor_lease() {
  local interval_ms=$(( lease_ms / 3 )) renew_after_ms last_success_ms now_ms result
  (( interval_ms < 200 )) && interval_ms=200
  (( interval_ms > 1000 )) && interval_ms=1000
  local retry_timeout_ms=$(( lease_ms / 4 ))
  local configured_timeout_ms
  configured_timeout_ms=$(seconds_to_ms "$CRONLOCK_REDIS_TIMEOUT" 0.1)
  (( retry_timeout_ms > configured_timeout_ms )) && retry_timeout_ms=$configured_timeout_ms
  last_success_ms=$(date +%s%3N)
  renew_after_ms=$(( last_success_ms + lease_ms / 3 ))
  while sleep "$(ms_to_seconds "$interval_ms")"; do
    kill -0 "$owner_pid" 2>/dev/null || return 0
    now_ms=$(date +%s%3N)
    (( now_ms >= renew_after_ms )) || continue
    if result=$(redis_once "$(ms_to_seconds "$retry_timeout_ms")" EVAL "$renew_lua" 1 "$key" "$token" "$lease_ms"); then
      if [[ $result == 1 ]]; then
        last_success_ms=$(date +%s%3N)
        renew_after_ms=$(( last_success_ms + lease_ms / 3 ))
        continue
      fi
      kill -USR1 "$owner_pid" 2>/dev/null || true
      return 0
    fi
    now_ms=$(date +%s%3N)
    if (( now_ms - last_success_ms >= lease_ms / 2 )); then
      kill -USR1 "$owner_pid" 2>/dev/null || true
      return 0
    fi
    renew_after_ms=$(( now_ms + interval_ms ))
  done
}

setsid -- "$@" &
child_pid=$!
[[ -z $stop_reason ]] || stop_job "$stop_reason"
monitor_lease &
monitor_pid=$!
if (( run_limit_ms > 0 )); then
  (sleep "$CRONLOCK_TIMEOUT"; kill -USR2 "$owner_pid" 2>/dev/null || true) &
  timer_pid=$!
fi

wait "$child_pid"
command_status=$?
if [[ -n $stop_reason ]]; then
  shutdown_ms=$(( lease_ms / 4 ))
  (( shutdown_ms > 5000 )) && shutdown_ms=5000
  if kill -0 -- "-$child_pid" 2>/dev/null; then
    sleep "$(ms_to_seconds "$shutdown_ms")"
    kill -KILL -- "-$child_pid" 2>/dev/null || true
  fi
  wait "$child_pid" 2>/dev/null || true
fi

kill "$monitor_pid" 2>/dev/null || true
wait "$monitor_pid" 2>/dev/null || true
if (( timer_pid > 0 )); then
  kill "$timer_pid" 2>/dev/null || true
  wait "$timer_pid" 2>/dev/null || true
fi
trap - TERM INT USR1 USR2

case $stop_reason in
  lease) command_status=201 ;;
  timeout) command_status=202 ;;
  term) command_status=143 ;;
  int) command_status=130 ;;
esac

now_ms=$(date +%s%3N)
remaining_ms=$(( started_ms + grace_ms - now_ms ))
(( remaining_ms > 0 )) || remaining_ms=0
release_lease "$remaining_ms" || die 'Redis lease could not be released safely'
exit "$command_status"
